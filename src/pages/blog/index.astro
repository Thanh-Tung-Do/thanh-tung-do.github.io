---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import BlogCard from '../../components/BlogCard.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [
  { id: 'all', label: 'All' },
  { id: 'data-tutorial', label: 'Tutorials' },
  { id: 'project-writeup', label: 'Projects' },
  { id: 'career-journey', label: 'Career' },
  { id: 'personal', label: 'Personal' },
];
---

<BaseLayout
  title="Writing — Ryan Do"
  description="Data science tutorials, project write-ups, and career reflections from Ryan Do, Business Insights Analyst."
>
  <Nav isHome={false} />

  <main class="blog-main">
    <div class="container">
      <header class="blog-header fade-in">
        <span class="section-label">Writing</span>
        <h1>Posts</h1>
        <p class="blog-sub">
          Data tutorials, project write-ups, and notes from six years of commercial analytics.
        </p>
      </header>

      {posts.length > 0 ? (
        <>
          <div class="filter-tabs fade-in" role="tablist">
            {categories.map(cat => (
              <button
                class="filter-tab"
                data-filter-tab={cat.id}
                role="tab"
                aria-selected={cat.id === 'all' ? 'true' : 'false'}
              >
                {cat.label}
              </button>
            ))}
          </div>

          <div class="posts-grid fade-in">
            {posts.map(post => (
              <div data-category={post.data.category} class="post-wrapper">
                <BlogCard
                  title={post.data.title}
                  date={post.data.date}
                  excerpt={post.data.excerpt}
                  tags={post.data.tags}
                  slug={post.slug}
                  category={post.data.category}
                  thumbnail={post.data.thumbnail}
                />
              </div>
            ))}
          </div>
          <p class="empty-state" id="empty-state">No posts in this category yet.</p>
        </>
      ) : (
        <div class="blog-empty fade-in">
          <div class="empty-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
          </div>
          <h2>Posts coming soon</h2>
          <p>
            I am working on tutorials and write-ups covering analytics, machine learning,
            and the projects you see in my portfolio. Check back soon.
          </p>
          <a href="/#portfolio" class="btn-primary">View my projects instead</a>
        </div>
      )}
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .blog-main { padding: 64px 0 96px; }

  .blog-header { margin-bottom: 40px; }
  .blog-header h1 { margin: 8px 0 12px; }
  .blog-sub { color: var(--color-muted); max-width: 540px; }

  .filter-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .filter-tab {
    padding: 7px 16px;
    border: 1.5px solid var(--color-border);
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-muted);
    background: transparent;
    cursor: pointer;
    transition: all var(--transition);
  }
  .filter-tab:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .filter-tab[aria-selected="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .post-wrapper[hidden] { display: none; }

  .empty-state {
    display: none;
    text-align: center;
    padding: 48px;
    color: var(--color-muted);
  }
  .empty-state.visible { display: block; }

  /* Empty state */
  .blog-empty {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
    padding: 80px 0;
  }
  .empty-icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--color-accent-lt);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
  }
  .blog-empty h2 { margin-bottom: 12px; }
  .blog-empty p {
    color: var(--color-muted);
    margin-bottom: 28px;
    line-height: 1.7;
  }

  @media (max-width: 960px) { .posts-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .posts-grid { grid-template-columns: 1fr; } }
</style>

<script is:inline>
(function () {
  var tabs = document.querySelectorAll('[data-filter-tab]');
  var posts = document.querySelectorAll('[data-category]');
  var emptyState = document.getElementById('empty-state');
  if (!tabs.length) return;

  function filter(category) {
    var count = 0;
    posts.forEach(function (p) {
      var show = category === 'all' || p.dataset.category === category;
      p.hidden = !show;
      if (show) count++;
    });
    tabs.forEach(function (t) {
      t.setAttribute('aria-selected', t.dataset.filterTab === category ? 'true' : 'false');
    });
    if (emptyState) emptyState.classList.toggle('visible', count === 0);
  }

  filter('all');
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () { filter(tab.dataset.filterTab); });
  });
})();
</script>
